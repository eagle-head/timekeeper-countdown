{
  "name": "timekeeper-countdown-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "test:ui": "npm run test:ui --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build --workspaces && changeset publish",
    "prepublishOnly": "npm run build --workspaces && npm run test --workspaces && npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.32.0",
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "eslint": "^9.32.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
